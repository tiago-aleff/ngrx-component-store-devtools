{
  "manifest_version": 3,
  "name": "NgRx ComponentStore DevTools",
  "version": "1.0.0",
  "description": "Automatically connects Angular NgRx ComponentStores to Redux DevTools Extension",
  "permissions": ["scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject/patch-component-store.js"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "http://*/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
